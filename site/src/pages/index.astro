---
// `/`: send the visitor to /hr/ or /en/. A stored choice (language switch) wins,
// then the browser languages; English is the fallback and the x-default.
import '../styles/global.css';
import { languages, langs } from '../i18n/ui';
const site = Astro.site!;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>open-ledger</title>
    <meta name="robots" content="noindex" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var lang = null;
        try { lang = localStorage.getItem('lang'); } catch (e) {}
        if (lang !== 'hr' && lang !== 'en') {
          var list = navigator.languages || [navigator.language || ''];
          lang = 'en';
          for (var i = 0; i < list.length; i++) {
            var p = String(list[i]).toLowerCase().split('-')[0];
            if (p === 'hr') { lang = 'hr'; break; }
            if (p === 'en') break;
          }
        }
        location.replace('/' + lang + '/' + location.hash);
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <main class="wrap">
      <p>
        {langs.map((l, i) => <>{i > 0 && ' · '}<a href={`/${l}/`} hreflang={l}>{languages[l]}</a></>)}
      </p>
    </main>
  </body>
</html>
