---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, langs, type Lang } from '../i18n/ui';
import { copy, text } from '../i18n/copy';
import facts from '../data/facts.json';

interface Props {
  lang: Lang;
  /** Path after the language prefix, e.g. '' for the home page or 'coverage/'. */
  path?: string;
  /** Page title and description; the home page falls back to copy.meta. */
  title?: string;
  description?: string;
}
const { lang, path = '', title, description } = Astro.props;
const t = ui[lang];
const meta = copy[lang].meta;
const site = Astro.site!;
const href = (l: Lang) => new URL(`/${l}/${path}`, site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? text(meta.title, facts)}</title>
    <meta name="description" content={description ?? text(meta.description, facts)} />
    <link rel="canonical" href={href(lang)} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <!-- Theme before first paint: a stored choice wins, otherwise prefers-color-scheme (CSS). -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
