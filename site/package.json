{
  "name": "open-ledger-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc --noEmit -p . && node scripts/make-og.mjs --check && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit -p .",
    "og": "node scripts/make-og.mjs",
    "og:check": "node scripts/make-og.mjs --check",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  }
}
